  border-radius: 7px;
  background: transparent;
  color: var(--muted);
  transition:
    background-color 0.25s ease,
    border-color 0.25s ease,
    color 0.25s ease,
    transform 0.25s ease;
  svg {
    width: 42px;
    height: 48px;
    transition: transform 0.25s ease;
  }
  &[aria-pressed="true"] {
    color: var(--wine);
    border-color: var(--wine);
    background: var(--paper);
  }
  &:hover {
    color: var(--wine);
    border-color: var(--wine);
    background: #f4f0e97a;
    transform: translateY(-2px);
  }
  &:hover svg {
    transform: translateY(-2px);
  }
  &:active {
    transform: translateY(1px);
  }
  &:hover .tooltip,
  &:focus-visible .tooltip {
    opacity: 1;
    transform: translate(-50%, 0);
  }
}
.nail {
  fill: currentColor;
  fill-opacity: 0.06;
  stroke: currentColor;
  stroke-width: 1.6;
  stroke-linejoin: round;
}
.cuticle {
  stroke: currentColor;
  stroke-width: 1;
  opacity: 0.45;
  stroke-linecap: round;
}
.tooltip {
  position: absolute;
  z-index: 4;
  bottom: calc(100% + 8px);
  left: 50%;
  padding: 7px 10px;
  border-radius: 4px;
  background: var(--ink);
  color: var(--paper);
  font-size: 10px;
  white-space: nowrap;
  pointer-events: none;
  opacity: 0;
  transform: translate(-50%, 4px);
  transition:
    opacity 0.2s ease,
    transform 0.2s ease;
}
</file>

