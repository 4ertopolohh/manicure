    font-family: monospace;
    font-size: 13px;
  }
}
.resultActions {
  display: flex;
  align-items: center;
  gap: 25px;
  margin-top: 20px;
}
.cancelButton {
  background: transparent;
  color: var(--wine);
  padding: 13px;
  border-radius: 5px;
  font-size: 11px;
  border: 1px solid transparent;
  transition: 0.25s;
  &:hover {
    border-color: var(--wine);
    background: #e6c9c6;
  }
}
.cancelPrompt {
  padding: 20px;
  background: #e9dcd6;
  margin-top: 20px;
  border-radius: 6px;
  p {
    font-size: 12px;
    margin-bottom: 17px;
  }
  :global(.button) {
    margin-right: 20px;
  }
}
.notice {
  font-size: 11px;
  color: var(--wine);
  margin-top: 20px;
}
.error {
  margin-top: 20px;
}
.manageForm {
  p {
    font-size: 12px;
    line-height: 1.8;
    color: var(--muted);
    margin-bottom: 24px;
  }
  :global(.button) {
    margin-top: 25px;
  }
}
@media (max-width: 650px) {
  .panel {
    padding: 22px;
  }
  .title {
    font-size: 37px;
    margin: 25px 0 18px;
  }
  .steps button {
    font-size: 9px;
  }
  .calendarLayout {
    grid-template-columns: 1fr;
    gap: 25px;
  }
  .calendar {
    max-width: 360px;
    width: 100%;
    margin: auto;
  }
  .days button {
    font-size: 13px;
  }
  .times {
    border-top: 1px solid var(--line);
    padding-top: 20px;
  }
  .timeGrid {
    grid-template-columns: repeat(4, 1fr);
  }
  .optionGrid {
    grid-template-columns: 1fr;
    gap: 19px;
  }
  .optionChoices button {
    padding: 11px 14px;
  }
  .contactFields {
    grid-template-columns: 1fr;
    gap: 18px;
  }
  .resultActions {
    gap: 10px;
    flex-wrap: wrap;
  }
  .bottom {
    gap: 12px;
    :global(.button) {
      padding: 15px 18px;
      font-size: 10px;
    }
  }
  .codeLabel input {
    font-size: 10px;
    padding: 13px 8px;
  }
  .dialog {
    width: calc(100% - 20px);
    max-height: 94dvh;
  }
  .serviceField button {
    font-size: 11px;
    padding: 14px 12px;
  }
  .contactFields input {
    font-size: 16px;
  }
  .calendarHead button {
    padding: 11px;
  }
  .result > p {
    font-size: 11px;
  }
}
